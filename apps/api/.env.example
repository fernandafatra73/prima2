# Local PostgreSQL (pgAdmin)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# USER = login pgAdmin (biasanya "postgres", BUKAN nama database)
# DATABASE = nama DB yang dibuat di pgAdmin (mis. labprima)
# Jika password ada @ # % dll, encode URL (spasi → %20)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/LabPrima?schema=public"
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN="http://localhost:5173"

# Google Gemini API key, dipakai fitur analisa foto AI (Anatomi > AI Foto).
# Dapatkan di https://aistudio.google.com/apikey
GEMINI_API_KEY=""
