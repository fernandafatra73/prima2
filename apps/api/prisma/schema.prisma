generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum StaffRole {
  ADMIN
  KARYAWAN
}

enum HasilStatus {
  MENUNGGU_HASIL
  SELESAI
}

enum PaymentStatus {
  BELUM_LUNAS
  LUNAS
}

enum SharingType {
  PERCENT
  FIXED
}

enum AsalModul {
  RADIOLOGI
  LABORATORIUM
}

model Dokter {
  id                    String   @id @default(cuid())
  nama                  String
  spesialisasi          String?
  noTelepon             String?
  namaBank              String?
  noRekening            String?
  defaultSharingAmount  Decimal  @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  pasien                Pasien[]
}

model KaryawanKlinik {
  id           String   @id @default(cuid())
  nama         String
  spesialisasi String?
  noTelepon    String?
  namaBank     String?
  noRekening   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Radiolog {
  id        String   @id @default(cuid())
  nama      String
  noTelepon String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pasien    Pasien[] @relation("PasienRadiolog")
}

model PetugasLab {
  id        String   @id @default(cuid())
  nama      String
  nip       String?
  noTelepon String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Radiografer {
  id        String   @id @default(cuid())
  nama      String
  noHp      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PetugasKasir {
  id        String   @id @default(cuid())
  nama      String
  noHp      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PetugasAdminKlinik {
  id        String   @id @default(cuid())
  nama      String
  noHp      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminPendaftaran {
  id            String   @id @default(cuid())
  nama          String
  noHp          String?
  statusHadir   String?
  statusTanggal String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LogoPerusahaan {
  id               String   @id @default(cuid())
  namaKlinik       String
  logoTandaTangan  String?
  logoPerusahaan   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model DaftarTelpon {
  id            String   @id @default(cuid())
  nama          String
  telpon        String?
  admin         String?
  password      String?
  noKontrak     String?
  namaInstansi  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model HitunganLed {
  id           String   @id @default(cuid())
  namaPasien   String
  jenisKelamin String
  jamPertama   Decimal
  jamKedua     Decimal
  tanggal      DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model KondisiAlat {
  id          String   @id @default(cuid())
  namaPasien  String
  kv          Decimal
  sekon       Decimal
  mAs         Decimal
  beratBadan  Decimal?
  tanggal     DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GajiKaryawan {
  id           String   @id @default(cuid())
  namaKaryawan String
  jabatan      String?
  bulan        String
  tanggal      DateTime @default(now())
  gajiPokok    Decimal  @default(0)
  tunjangan    Decimal  @default(0)
  potongan     Decimal  @default(0)
  gajiBersih   Decimal  @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Karyawan {
  id         String   @id @default(cuid())
  nama       String
  jabatan    String?
  noTelepon  String?
  alamat     String?
  departemen String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BhpRadiologi {
  id           String   @id @default(cuid())
  tanggal      DateTime @default(now())
  pemakaian    String
  harga        Decimal  @default(0)
  dev          Decimal  @default(0)
  fixer        Decimal  @default(0)
  film         Decimal  @default(0)
  amplopKertas Decimal  @default(0)
  listrik      Decimal  @default(0)
  gajiKaryawan Decimal  @default(0)
  kertasCetak  Decimal  @default(0)
  amplop       Decimal  @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LaporanPajakOverride {
  id              String   @id @default(cuid())
  year            Int
  bulan           Int
  modul           AsalModul @default(RADIOLOGI)
  jumlahPasien    Int
  harga           Decimal
  totalPenerimaan Decimal
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([year, bulan, modul])
}

model LaporanNeraca {
  id                 String   @id @default(cuid())
  year               Int      @unique
  namaPerusahaan     String   @default("CV. PRIMA MANDIRI NUSANTARA")

  // Aktiva Lancar
  kas                Decimal  @default(0)
  bank               Decimal  @default(0)
  piutang            Decimal  @default(0)
  persediaan         Decimal  @default(0)

  // Aktiva Tetap
  tanah              Decimal  @default(0)
  gedung             Decimal  @default(0)
  peralatan          Decimal  @default(0)
  kendaraan          Decimal  @default(0)

  // Pasiva - Utang Jangka Pendek
  utangUsaha         Decimal  @default(0)
  utangPajak         Decimal  @default(0)
  utangLainnya       Decimal  @default(0)

  // Pasiva - Utang Jangka Panjang
  utangJangkaPanjang Decimal  @default(0)

  // Pasiva - Modal
  modalUsaha         Decimal  @default(0)

  // Laporan Rugi Laba
  pendapatan         Decimal  @default(0)
  biayaGaji          Decimal  @default(0)
  biayaAtkBahan      Decimal  @default(0)
  biayaListrik       Decimal  @default(0)
  biayaTelpon        Decimal  @default(0)
  biayaTransport     Decimal  @default(0)
  biayaSewa          Decimal  @default(0)
  biayaLainLain      Decimal  @default(0)

  // Tanda tangan
  tempatTandaTangan  String   @default("Sukabumi")
  tanggalTandaTangan DateTime @default(now())
  namaPenandatangan  String   @default("")

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Pengaturan kop surat (logo, nama klinik, alamat, telepon) dipakai bersama
/// oleh template surat (Surat Keterangan Sehat, Surat Keterangan Rujukan).
/// Singleton: selalu diakses/diubah lewat baris id = "default".
model KopSurat {
  id          String   @id @default("default")
  namaKlinik  String   @default("KLINIK PRIMA HUSADA")
  alamat      String   @default("Jl. Siliwangi Ruko Palapa No 2 Parung Kuda")
  telepon     String   @default("0857-1932-5557")
  logoDataUrl String?
  updatedAt   DateTime @updatedAt
}

model SuratKeteranganSehat {
  id                 String   @id @default(cuid())
  nomorSurat         String?
  namaPasien         String
  tempatTanggalLahir String?
  jenisKelamin       String   @default("Laki-laki")
  pekerjaan          String?
  alamatPasien       String?
  hasilPemeriksaan   String?
  keperluan          String?
  tempatSurat        String?
  tanggalSurat       DateTime @default(now())
  namaDokter         String?
  jabatanDokter      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SuratKeteranganRujukan {
  id                 String   @id @default(cuid())
  nomorSurat         String?
  namaPasien         String
  tempatTanggalLahir String?
  jenisKelamin       String   @default("Laki-laki")
  alamatPasien       String?
  dirujukKe          String?
  diagnosaKeluhan    String?
  alasanRujukan      String?
  tempatSurat        String?
  tanggalSurat       DateTime @default(now())
  namaDokter         String?
  jabatanDokter      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Daftar tanda tangan elektronik (nama, gambar tanda tangan, alamat) yang
/// bisa dipakai untuk kolom penandatangan pada dokumen cetak (kwitansi, surat, dsb).
model TandaTanganElektronik {
  id              String   @id @default(cuid())
  nama            String
  logoTandaTangan String?
  alamat          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Arsip foto rontgen pasien beserta kesan/diagnosa yang diisi manual oleh
/// radiolog/dokter (BUKAN deteksi otomatis AI — lihat catatan produk).
model AnalisaFotoRontgen {
  id               String   @id @default(cuid())
  namaPasien       String
  regCode          String?
  jenisPemeriksaan String?
  tanggal          DateTime @default(now())
  fotoDataUrl      String
  kesan            String?
  diagnosa         String?
  radiologNama     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model JenisPemeriksaan {
  id        String              @id @default(cuid())
  nama      String              @unique
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  harga     HargaLayanan?
  pasienItems PasienPemeriksaan[]
}

model HargaLayanan {
  id                 String           @id @default(cuid())
  jenisPemeriksaanId String           @unique
  jenisPemeriksaan   JenisPemeriksaan @relation(fields: [jenisPemeriksaanId], references: [id], onDelete: Cascade)
  harga              Decimal
  detailLayanan      String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model KesanTemplate {
  id        String   @id @default(cuid())
  judul     String
  isi       String
  gambar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnatomiGambar {
  id         String   @id @default(cuid())
  regio      String
  gambar     String
  thumbnail  String?
  keterangan String?
  createdAt  DateTime @default(now())

  @@index([regio])
}

model PlaylistLagu {
  id        String   @id @default(cuid())
  judul     String
  audioData String
  lirik     String?
  createdAt DateTime @default(now())
}

model KesanBacaanGrup {
  id        String                @id @default(cuid())
  nama      String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  kategori  KesanBacaanKategori[]
}

model KesanBacaanKategori {
  id        String          @id @default(cuid())
  grupId    String
  grup      KesanBacaanGrup @relation(fields: [grupId], references: [id], onDelete: Cascade)
  nama      String
  urutan    Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  bacaan    KesanBacaan[]

  @@index([grupId])
}

model KesanBacaan {
  id         String              @id @default(cuid())
  kategoriId String
  kategori   KesanBacaanKategori @relation(fields: [kategoriId], references: [id], onDelete: Cascade)
  teks       String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([kategoriId])
}

model Staff {
  id           String    @id @default(cuid())
  nama         String
  email        String    @unique
  passwordHash String    @default("")
  role         StaffRole @default(KARYAWAN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Pasien {
  id              String        @id @default(cuid())
  regCode         String        @unique
  nama            String
  tanggalLahir    DateTime
  noTelepon       String?
  alamat          String?
  pengirimId      String
  pengirim        Dokter        @relation(fields: [pengirimId], references: [id])
  asalModul       AsalModul     @default(RADIOLOGI)
  klinis          String?
  hasilStatus     HasilStatus   @default(MENUNGGU_HASIL)
  paymentStatus   PaymentStatus @default(BELUM_LUNAS)
  sharingType     SharingType   @default(PERCENT)
  sharingPercent  Decimal       @default(0)
  sharingAmount   Decimal?
  totalHarga      Decimal       @default(0)
  totalSharing    Decimal       @default(0)
  sharingLocked   Boolean       @default(false)
  kesan           String?
  admin           String?
  petugasKasir    String?
  radiologId      String?
  radiolog        Radiolog?     @relation("PasienRadiolog", fields: [radiologId], references: [id])
  pemeriksaan     PasienPemeriksaan[]
  paketLab        PasienPaketLab[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

/// Salinan arsip Pasien: disinkron setiap kali Pasien dibuat/diubah, dan TIDAK
/// terhubung lewat foreign key sehingga tetap ada walau data Pasien aslinya dihapus.
model PasienDuplikat {
  id              String        @id @default(cuid())
  sourcePasienId  String        @unique
  regCode         String
  nama            String
  tanggalLahir    DateTime
  noTelepon       String?
  alamat          String?
  pengirimNama    String
  radiologNama    String?
  asalModul       AsalModul     @default(RADIOLOGI)
  klinis          String?
  kesan           String?
  hasilStatus     HasilStatus   @default(MENUNGGU_HASIL)
  paymentStatus   PaymentStatus @default(BELUM_LUNAS)
  pemeriksaanNama String        @default("")
  petugasKasir    String?
  totalHarga      Decimal       @default(0)
  totalSharing    Decimal       @default(0)
  registeredAt    DateTime
  archivedAt      DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Transfer {
  id             String   @id @default(cuid())
  namaBank       String
  noRekening     String
  jumlah         Decimal
  namaTransferan String
  tanggal        DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PasienPemeriksaan {
  id                 String           @id @default(cuid())
  pasienId           String
  pasien             Pasien           @relation(fields: [pasienId], references: [id], onDelete: Cascade)
  jenisPemeriksaanId String
  jenisPemeriksaan   JenisPemeriksaan @relation(fields: [jenisPemeriksaanId], references: [id])
  hargaSnapshot      Decimal

  @@unique([pasienId, jenisPemeriksaanId])
}

model PaketLab {
  id        String           @id @default(cuid())
  nama      String           @unique
  harga     Decimal          @default(0)
  urutan    Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  items     PaketLabItem[]
  pasien    PasienPaketLab[]
}

/// Paket Lab yang dipilih untuk seorang Pasien (asalModul LABORATORIUM).
/// Terpisah dari PasienPemeriksaan karena PaketLab tidak berelasi dengan
/// JenisPemeriksaan (harga & masternya berbeda dari Jenis Pemeriksaan Radiologi).
model PasienPaketLab {
  id            String   @id @default(cuid())
  pasienId      String
  pasien        Pasien   @relation(fields: [pasienId], references: [id], onDelete: Cascade)
  paketLabId    String
  paketLab      PaketLab @relation(fields: [paketLabId], references: [id])
  hargaSnapshot Decimal
  createdAt     DateTime @default(now())

  @@unique([pasienId, paketLabId])
}

model PaketLabItem {
  id           String   @id @default(cuid())
  paketId      String
  paket        PaketLab @relation(fields: [paketId], references: [id], onDelete: Cascade)
  grup         String?
  pemeriksaan  String
  nilaiRujukan String   @default("")
  satuan       String   @default("")
  harga        Decimal  @default(0)
  urutan       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PendaftaranUmum {
  id             String   @id @default(cuid())
  noRegistrasi   String   @unique
  namaPasien     String
  umur           String?
  alamat         String?
  telpon         String?
  tanggalMasuk   DateTime @default(now())
  dokterPengirim String?
  klinis         String?
  admin          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FarmasiBhp {
  id             String    @id @default(cuid())
  kode           String    @unique
  nama           String
  kategori       String    @default("OBAT")
  satuan         String    @default("Pcs")
  stok           Int       @default(0)
  stokMin        Int       @default(10)
  hargaBeli      Decimal   @default(0)
  hargaJual      Decimal   @default(0)
  keterangan     String?   @default("")
  tanggalBeli    DateTime?
  tanggalExpire  DateTime?
  penyedia       String?
  telponPenyedia String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AbsensiKaryawan {
  id           String   @id @default(cuid())
  namaKaryawan String
  role         String?  @default("KARYAWAN")
  tanggal      String
  jamMasuk     String?  @default("08:00")
  jamPulang    String?  @default("16:00")
  status       String   @default("HADIR")
  keterangan   String?  @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model KeuanganTransaksi {
  id         String   @id @default(cuid())
  tanggal    String
  jenis      String   @default("MASUK")
  kategori   String   @default("LAYANAN")
  keterangan String
  nominal    Decimal  @default(0)
  referensi  String?  @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}


